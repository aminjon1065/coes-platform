{
  "name": "coescd-platform",
  "version": "0.1.0",
  "description": "CoESCD Unified Digital Platform — Monorepo Root",
  "private": true,
  "workspaces": [
    "apps/backend",
    "apps/gateway",
    "apps/web",
    "apps/map-client",
    "apps/field-pwa",
    "shared/*"
  ],
  "scripts": {
    "install:all": "npm install && npm install --prefix apps/backend && npm install --prefix apps/gateway && npm install --prefix apps/web",
    "dev:backend": "npm --prefix apps/backend run start:dev",
    "dev:gateway": "npm --prefix apps/gateway run start:dev",
    "dev:web": "npm --prefix apps/web run dev",
    "dev:map": "npm --prefix apps/map-client run dev",
    "build:backend": "npm --prefix apps/backend run build",
    "build:gateway": "npm --prefix apps/gateway run build",
    "build:web": "npm --prefix apps/web run build",
    "test:backend": "npm --prefix apps/backend run test",
    "lint:backend": "npm --prefix apps/backend run lint",
    "lint:gateway": "npm --prefix apps/gateway run lint",
    "lint:web": "npm --prefix apps/web run lint",
    "dc": "docker compose -f infra/docker/docker-compose.yml --env-file .env.local",
    "infra:up": "docker compose -f infra/docker/docker-compose.yml --env-file .env.local up -d",
    "infra:down": "docker compose -f infra/docker/docker-compose.yml --env-file .env.local down",
    "app:up": "docker compose -f infra/docker/docker-compose.yml --env-file .env.local --profile app up -d",
    "app:down": "docker compose -f infra/docker/docker-compose.yml --env-file .env.local --profile app down",
    "obs:up": "docker compose -f infra/docker/docker-compose.yml --env-file .env.local --profile obs up -d",
    "obs:down": "docker compose -f infra/docker/docker-compose.yml --env-file .env.local --profile obs down",
    "all:up": "docker compose -f infra/docker/docker-compose.yml --env-file .env.local --profile app --profile obs up -d",
    "all:down": "docker compose -f infra/docker/docker-compose.yml --env-file .env.local --profile app --profile obs down",
    "migration:run": "npm --prefix apps/backend run migration:run",
    "migration:revert": "npm --prefix apps/backend run migration:revert"
  },
  "devDependencies": {
    "prettier": "^3.2.5"
  }
}
