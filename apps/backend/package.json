{
  "name": "@coescd/backend",
  "version": "0.1.0",
  "description": "CoESCD Unified Digital Platform — Core Backend (Modular Monolith)",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:smoke": "jest --runInBand modules/tasks/listeners/tasks-edms.listener.spec.ts modules/files/services/files.service.spec.ts modules/files/listeners/file-scan.listener.spec.ts modules/gis/services/gis.service.spec.ts modules/search/listeners/search-indexing.listener.spec.ts modules/search/services/search-maintenance.service.spec.ts modules/notifications/services/notification.service.spec.ts",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "typeorm:metadata": "node --require ts-node/register ./src/infra/database/ensure-typeorm-metadata.ts",
    "migration:baseline": "node --require ts-node/register ./src/infra/database/baseline-migrations.ts",
    "migration:run": "node --require ts-node/register ./node_modules/typeorm/cli.js migration:run -d src/infra/database/data-source.ts",
    "migration:revert": "node --require ts-node/register ./node_modules/typeorm/cli.js migration:revert -d src/infra/database/data-source.ts",
    "seed:run": "node --require ts-node/register ./src/infra/database/seeds/run-seeds.ts",
    "migration:create": "node --require ts-node/register ./node_modules/typeorm/cli.js migration:create",
    "migration:new": "yarn migration:create",
    "migration:generate": "sh -c 'echo \"ERROR: Do not use migration:generate/diff. Use: yarn migration:create src/infra/database/migrations/YourMigrationName\" && exit 1'",
    "migration:diff": "sh -c 'echo \"ERROR: Do not use migration:diff. Use: yarn migration:create src/infra/database/migrations/YourMigrationName\" && exit 1'"
  },
  "dependencies": {
    "@fastify/multipart": "^8.3.0",
    "@fastify/static": "^7.0.0",
    "@nestjs/cache-manager": "^2.2.2",
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/event-emitter": "^2.0.4",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-fastify": "^10.3.0",
    "@nestjs/platform-ws": "^10.3.0",
    "@nestjs/schedule": "^4.1.0",
    "@nestjs/websockets": "^10.3.0",
    "@nestjs/swagger": "^7.3.0",
    "@nestjs/throttler": "^5.1.2",
    "@nestjs/typeorm": "^10.0.2",
    "@node-saml/node-saml": "^5.0.0",
    "@opensearch-project/opensearch": "^2.6.0",
    "amqplib": "^0.10.4",
    "bcrypt": "^5.1.1",
    "cache-manager": "^5.4.0",
    "cache-manager-ioredis-yet": "^2.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "fastify": "^4.28.1",
    "ioredis": "^5.3.2",
    "ldapts": "^7.0.6",
    "minio": "^7.1.3",
    "ms": "^2.1.3",
    "nodemailer": "^8.0.4",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.11.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20",
    "uuid": "^9.0.1",
    "otplib": "^13.4.0",
    "qrcode": "^1.5.4",
    "web-push": "^3.6.7",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.2",
    "@nestjs/schematics": "^10.1.1",
    "@nestjs/testing": "^10.3.0",
    "@types/amqplib": "^0.10.5",
    "@types/ws": "^8.5.12",
    "@types/bcrypt": "^5.0.2",
    "@types/jest": "^29.5.12",
    "@types/minio": "^7.1.1",
    "@types/ms": "^0.7.34",
    "@types/node": "^20.12.7",
    "@types/nodemailer": "^8.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/pg": "^8.11.5",
    "@types/uuid": "^9.0.8",
    "@types/qrcode": "^1.5.5",
    "@types/web-push": "^3.6.4",
    "@typescript-eslint/eslint-plugin": "^7.7.0",
    "@typescript-eslint/parser": "^7.7.0",
    "dotenv": "^16.4.5",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
