# ─────────────────────────────────────────────────────────────────────────────
# CoESCD Platform — Environment Variables (local development)
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# ─── Database ────────────────────────────────────────────────────────────────
# DB_HOST must be "postgres" when backend runs inside Docker,
# or "localhost" when running backend with npm run start:dev on host.
DB_HOST=localhost
DB_PORT=5432
DB_USER=coescd
DB_PASSWORD=coescd_dev
DB_NAME=coescd
DB_SSL=false

# These are used by the postgres Docker container itself — must match DB_PASSWORD
POSTGRES_USER=coescd
POSTGRES_PASSWORD=coescd_dev
POSTGRES_DB=coescd

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_dev

# ─── RabbitMQ ────────────────────────────────────────────────────────────────
RABBITMQ_USER=coescd
RABBITMQ_PASSWORD=rabbit_dev
RABBITMQ_URL=amqp://coescd:rabbit_dev@localhost:5672/coescd

# ─── MinIO ───────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=coescd_admin
MINIO_ROOT_PASSWORD=minio_dev_pass
MINIO_ENDPOINT=localhost
MINIO_PORT=9002
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=coescd_admin
MINIO_SECRET_KEY=minio_dev_pass

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=b46229675eacc79d82e506a973456fc6dd9f5a152b6758161571078df60465e015e4a06d8c6ac717c17bff3841edc715d85f2e0f6275ef15406865a142642992
JWT_REFRESH_SECRET=6a508385c6e92a458fd39810da44fe2df120d371e5d99d2b39c46b97bb3e87b75bcaeeba12fcddba054a9a47e3a60b94e7590ac393d403b1238b7a394773f71f
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Rate Limiting ───────────────────────────────────────────────────────────
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# ─── OpenSearch ──────────────────────────────────────────────────────────────
OPENSEARCH_NODE=http://localhost:9200
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=admin

# ─── CORS ────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174

# ─── Observability ───────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=observer

# ─── Media / WebRTC ──────────────────────────────────────────────────────────
MEDIASOUP_ANNOUNCED_IP=127.0.0.1
MEDIASOUP_WORKERS=2
RTC_MIN_PORT=10000
RTC_MAX_PORT=10100

# ─── Coturn STUN/TURN ────────────────────────────────────────────────────────
TURN_EXTERNAL_IP=127.0.0.1
TURN_REALM=coescd.local
TURN_USER=coescd
TURN_PASSWORD=turn_dev

# ─── TimescaleDB (Analytics) ─────────────────────────────────────────────────
TIMESCALE_PASSWORD=timescale_dev

# ─── GeoServer ───────────────────────────────────────────────────────────────
GEOSERVER_ADMIN_PASSWORD=geoserver_dev

# ─── Airflow ─────────────────────────────────────────────────────────────────
AIRFLOW_DB_PASSWORD=coescd_dev
AIRFLOW_FERNET_KEY=46BKJoQYlPPOexq0OhDZnIlNepKFf87WFwLt0nIe3aI=
AIRFLOW_SECRET_KEY=airflow-secret-key-local
AIRFLOW_ADMIN_PASSWORD=airflow_admin

# ─── ClickHouse (ML) ─────────────────────────────────────────────────────────
CLICKHOUSE_PASSWORD=clickhouse_dev

# ─── MLflow ──────────────────────────────────────────────────────────────────
MLFLOW_DB_PASSWORD=mlflow_dev
