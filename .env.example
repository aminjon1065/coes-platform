# ─────────────────────────────────────────────────────────────────────────────
# CoESCD Platform — Environment Variables (local development)
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# ─── Database ────────────────────────────────────────────────────────────────
# DB_HOST must be "postgres" when backend runs inside Docker,
# or "localhost" when running backend with npm run start:dev on host.
DB_HOST=localhost
DB_PORT=5432
DB_USER=coescd
DB_PASSWORD=coescd_dev
DB_NAME=coescd
DB_SSL=false

# These are used by the postgres Docker container itself — must match DB_PASSWORD
COESCD_POSTGRES_USER=coescd
COESCD_POSTGRES_PASSWORD=coescd_dev
COESCD_POSTGRES_DB=coescd
POSTGRES_USER=coescd
POSTGRES_PASSWORD=coescd_dev
POSTGRES_DB=coescd

# ─── Redis ───────────────────────────────────────────────────────────────────
COESCD_REDIS_PASSWORD=redis_dev
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_dev

# ─── RabbitMQ ────────────────────────────────────────────────────────────────
COESCD_RABBITMQ_USER=coescd
COESCD_RABBITMQ_PASSWORD=rabbit_dev
RABBITMQ_USER=coescd
RABBITMQ_PASSWORD=rabbit_dev
RABBITMQ_URL=amqp://coescd:rabbit_dev@localhost:5672/coescd

# ─── MinIO ───────────────────────────────────────────────────────────────────
COESCD_MINIO_ROOT_USER=coescd_admin
COESCD_MINIO_ROOT_PASSWORD=minio_dev_pass
COESCD_MINIO_ACCESS_KEY=coescd_admin
COESCD_MINIO_SECRET_KEY=minio_dev_pass
MINIO_ROOT_USER=coescd_admin
MINIO_ROOT_PASSWORD=minio_dev_pass
MINIO_ENDPOINT=localhost
MINIO_PORT=9002
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=coescd_admin
MINIO_SECRET_KEY=minio_dev_pass
CLAMAV_ENABLED=false
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=30000
CLAMAV_CHUNK_SIZE=65536
SMTP_ENABLED=false
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@coescd.local
SMTP_REPLY_TO=
SMTP_TIMEOUT_MS=10000
SMTP_REQUIRE_TLS=false
SMTP_IGNORE_TLS=false
SMS_ENABLED=false
SMS_PROVIDER_URL=
SMS_PROVIDER_TOKEN=
SMS_PROVIDER_AUTH_HEADER=Authorization
SMS_PROVIDER_TOKEN_PREFIX=Bearer 
SMS_SENDER=COESCD
SMS_TIMEOUT_MS=10000
SMS_DEFAULT_COUNTRY_CODE=992
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_NAME=coescd_bot
TELEGRAM_WEBHOOK_SECRET=change-me-random-secret
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_TIMEOUT_MS=10000
TELEGRAM_DISABLE_LINK_PREVIEW=true
WEB_PUSH_ENABLED=false
WEB_PUSH_SUBJECT=mailto:alerts@coescd.local
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_TTL_SECONDS=300
WEB_PUSH_URGENCY=high
VITE_VAPID_PUBLIC_KEY=

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=b46229675eacc79d82e506a973456fc6dd9f5a152b6758161571078df60465e015e4a06d8c6ac717c17bff3841edc715d85f2e0f6275ef15406865a142642992
JWT_REFRESH_SECRET=6a508385c6e92a458fd39810da44fe2df120d371e5d99d2b39c46b97bb3e87b75bcaeeba12fcddba054a9a47e3a60b94e7590ac393d403b1238b7a394773f71f
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Rate Limiting ───────────────────────────────────────────────────────────
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# ─── OpenSearch ──────────────────────────────────────────────────────────────
OPENSEARCH_NODE=http://localhost:9200
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=admin

# ─── CORS ────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174

# ─── Observability ───────────────────────────────────────────────────────────
COESCD_GRAFANA_ADMIN_USER=admin
COESCD_GRAFANA_ADMIN_PASSWORD=observer
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=observer

# ─── Media / WebRTC ──────────────────────────────────────────────────────────
MEDIASOUP_ANNOUNCED_IP=127.0.0.1
MEDIASOUP_WORKERS=2
RTC_MIN_PORT=10000
RTC_MAX_PORT=10100
PORTAL_MEDIA_WS_URL=ws://localhost:4002/ws
PORTAL_MEDIA_STUN_URL=stun:127.0.0.1:3478
PORTAL_MEDIA_TURN_URL=turn:127.0.0.1:3478?transport=udp
PORTAL_MEDIA_TURNS_URL=turns:127.0.0.1:5349?transport=tcp
MEDIA_FFMPEG_PATH=ffmpeg
MEDIA_RECORDINGS_DIR=var/recordings
MEDIA_RECORDING_ARTIFACT_PREFIX=recordings
CALLS_RECORDING_RETENTION_CRON=30 3 * * *

# ─── Coturn STUN/TURN ────────────────────────────────────────────────────────
COESCD_TURN_EXTERNAL_IP=127.0.0.1
COESCD_TURN_REALM=coescd.local
COESCD_TURN_USER=coescd
COESCD_TURN_PASSWORD=turn_dev
TURN_EXTERNAL_IP=127.0.0.1
TURN_REALM=coescd.local
TURN_USER=coescd
TURN_PASSWORD=turn_dev

# ─── TimescaleDB (Analytics) ─────────────────────────────────────────────────
COESCD_TIMESCALE_USER=coescd_analytics
COESCD_TIMESCALE_PASSWORD=timescale_dev
COESCD_TIMESCALE_DB=coescd_analytics
TIMESCALE_PASSWORD=timescale_dev

# ─── GeoServer ───────────────────────────────────────────────────────────────
COESCD_GEOSERVER_ADMIN_USER=geoserver_admin
COESCD_GEOSERVER_ADMIN_PASSWORD=geoserver_dev
GEOSERVER_ADMIN_PASSWORD=geoserver_dev

# ─── Airflow ─────────────────────────────────────────────────────────────────
COESCD_AIRFLOW_DB_USER=airflow
COESCD_AIRFLOW_DB_PASSWORD=coescd_dev
COESCD_AIRFLOW_DB_NAME=airflow
COESCD_AIRFLOW_ADMIN_USER=airflow_admin
COESCD_AIRFLOW_ADMIN_PASSWORD=airflow_admin
COESCD_AIRFLOW_ADMIN_EMAIL=admin@coescd.local
AIRFLOW_DB_PASSWORD=coescd_dev
AIRFLOW_FERNET_KEY=46BKJoQYlPPOexq0OhDZnIlNepKFf87WFwLt0nIe3aI=
AIRFLOW_SECRET_KEY=airflow-secret-key-local
AIRFLOW_ADMIN_PASSWORD=airflow_admin

# ─── ClickHouse (ML) ─────────────────────────────────────────────────────────
COESCD_CLICKHOUSE_DB=coescd_ml
COESCD_CLICKHOUSE_USER=coescd_ml
COESCD_CLICKHOUSE_PASSWORD=clickhouse_dev
CLICKHOUSE_PASSWORD=clickhouse_dev

# ─── MLflow ──────────────────────────────────────────────────────────────────
COESCD_MLFLOW_DB_USER=mlflow
COESCD_MLFLOW_DB_PASSWORD=mlflow_dev
COESCD_MLFLOW_DB_NAME=mlflow
MLFLOW_DB_PASSWORD=mlflow_dev

# ─── Docker Compose defaults ────────────────────────────────────────────────
COMPOSE_PROFILES=app
