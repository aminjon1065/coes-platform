# ─────────────────────────────────────────────────────────────────────────────
# CoESCD Platform — Environment Variables
# Copy to .env.local for local development, .env for production
# NEVER commit .env or .env.local to version control
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# ─── Database ────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=coescd
DB_PASSWORD=postgres
DB_NAME=coescd
DB_SSL=false

POSTGRES_USER=coescd
POSTGRES_PASSWORD=postgres
POSTGRES_DB=coescd

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis

# ─── RabbitMQ ────────────────────────────────────────────────────────────────
RABBITMQ_USER=coescd
RABBITMQ_PASSWORD=rabbit
RABBITMQ_URL=amqp://coescd:rabbit@localhost:5672/coescd

# ─── MinIO ───────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=coescd_admin
MINIO_ROOT_PASSWORD=minio
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false

# ─── JWT (generate with: openssl rand -hex 64) ───────────────────────────────
JWT_ACCESS_SECRET=gdUq4309QAadNtNSUTN3mWA5stsnSSsZ0eKBTqgjsP8=aw
JWT_REFRESH_SECRET=87ay6dagdUq4309QAadNtNSUTN3mWA5stsnSSsZ0eKBTqgjsP8=adawdaw
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Rate Limiting ───────────────────────────────────────────────────────────
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# ─── OpenSearch ──────────────────────────────────────────────────────────────
OPENSEARCH_NODE=http://localhost:9200
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=admin

# ─── CORS ────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000

# ─── Observability ───────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=observer

# ─── Media / WebRTC ──────────────────────────────────────────────────────────
MEDIASOUP_ANNOUNCED_IP=127.0.0.1
MEDIASOUP_WORKERS=2
RTC_MIN_PORT=10000
RTC_MAX_PORT=10100

# ─── Coturn STUN/TURN ────────────────────────────────────────────────────────
TURN_EXTERNAL_IP=127.0.0.1
TURN_REALM=coescd.local
TURN_USER=coescd
TURN_PASSWORD=changeme
